# Copy to .env and fill in.  cp .env.example .env
#
# The first five are validated by src/config/env.js at startup — a missing or
# malformed value exits the process rather than booting a broken server.
# Everything below them is read with a fallback and is NOT validated.

# ---- validated ----------------------------------------------------------
PORT=5002
# Must be a full mongodb:// or mongodb+srv:// URL. No localhost fallback: a
# deploy with this unset fails to start instead of writing to an empty local DB.
MONGO_URI=mongodb://localhost:27017/abelup
# Minimum 10 characters.
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
# Reverse-proxy hops in front of this server, so the rate limiters key off the
# real client IP instead of the proxy's. 0 when Node is exposed directly (local
# dev, and the Vite dev proxy, which sends no X-Forwarded-For). 1 behind a
# single nginx / Render / Fly / Heroku layer. Never Express's `true`:
# express-rate-limit rejects it, because a forged X-Forwarded-For would then
# give every request its own bucket.
TRUST_PROXY=0

# ---- not validated (defaults shown) -------------------------------------
JWT_EXPIRES_IN=7d

# Used to build password-reset links. Defaults to http://localhost:5173, which
# is NOT where Vite serves this project — set it to the frontend's real origin.
FRONTEND_URL=http://localhost:8080

# Public uploads (logos, resumes) served by express.static at /uploads.
UPLOAD_DIR=./uploads/resumes
LOGO_UPLOAD_DIR=./uploads/logos
# Verification documents live OUTSIDE the static root on purpose — they are
# served only by /api/documents, behind auth and an ownership check.
VERIFICATION_UPLOAD_DIR=./private/verification

# Email is a best-effort side channel. With SMTP_USER / SMTP_PASS unset the
# mailer no-ops and logs a warning; no core flow fails because of it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
