# Copy to .env only if you need to override a default.  cp .env.example .env
#
# For local development you want NEITHER of these set. The dev server proxies
# /api and /uploads to the backend (see vite.config.js), which keeps the API
# same-origin and avoids a CORS preflight before every request.

# Base URL of the backend API, including the /api prefix. Setting this bypasses
# the dev proxy entirely and brings the preflights back, with no error to
# explain the extra requests — so set it only for production builds, where it
# must point at the real API origin.
# VITE_API_URL=https://api.example.com/api

# Where the dev proxy forwards. Only needed if the backend is not on 5002
# (backend/.env -> PORT). Prefer 127.0.0.1 over localhost, which can resolve to
# ::1 first and fail to connect.
# VITE_PROXY_TARGET=http://127.0.0.1:5002
